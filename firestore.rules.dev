// DEVELOPMENT FIRESTORE RULES - GenZFit
// Scoped dev rules with role-aware permissions for admin operations.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && (
        getUserRole() == 'admin' ||
        getUserRole() == 'super_admin'
      );
    }

    function isFinanceAdmin() {
      return isSignedIn() && (
        getUserRole() == 'finance_admin' ||
        getUserRole() == 'financeAdmin'
      );
    }

    function isModerator() {
      return isSignedIn() && getUserRole() == 'moderator';
    }

    function isSupport() {
      return isSignedIn() && getUserRole() == 'support';
    }

    function isAnyAdminRole() {
      return isAdmin() || isFinanceAdmin() || isModerator() || isSupport();
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId || isAnyAdminRole();
      allow delete: if isAdmin();
    }

    match /measurements/{measurementId} {
      allow read, write: if isSignedIn();
    }

    match /avatars/{avatarId} {
      allow read, write: if isSignedIn();
    }

    match /trainers/{trainerId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == trainerId || isAnyAdminRole();

      match /bank_details/{bankDetailsId} {
        allow read: if isSignedIn() && request.auth.uid == trainerId || isFinanceAdmin() || isAdmin();
        allow create, update: if isSignedIn() && request.auth.uid == trainerId || isFinanceAdmin() || isAdmin();
        allow delete: if isSignedIn() && request.auth.uid == trainerId || isAdmin();
      }
    }

    // Collection-group compatibility for admin bank verification.
    match /{path=**}/bank_details/{bankDetailsId} {
      allow read: if isFinanceAdmin() || isAdmin();
      allow update: if isFinanceAdmin() || isAdmin();
    }

    match /chats/{chatId} {
      allow read, write: if isSignedIn();
      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    match /sessions/{sessionId} {
      allow read, write: if isSignedIn();
    }

    match /user_preferences/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAnyAdminRole());
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /recommendations/{recommendationId} {
      allow read, write: if isSignedIn();
    }

    match /chatbot_history/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      match /conversations/{messageId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /platform_analytics/{document=**} {
      allow read, write: if isAnyAdminRole();
    }

    match /verification_requests/{requestId} {
      allow read, write: if isSignedIn();
    }

    match /reports/{reportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isModerator() || isSupport() || isAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isFinanceAdmin() ||
        isAdmin() ||
        request.resource.data.clientId == request.auth.uid
      );
    }

    match /withdrawal_requests/{withdrawalId} {
      allow read: if isSignedIn() && (
        resource.data.trainerId == request.auth.uid ||
        isFinanceAdmin() ||
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.trainerId == request.auth.uid;
      allow update, delete: if isFinanceAdmin() || isAdmin();
    }

    match /earnings_ledger/{ledgerId} {
      allow read: if isSignedIn() && (
        resource.data.trainerId == request.auth.uid ||
        isFinanceAdmin() ||
        isAdmin()
      );
      allow create, update, delete: if isFinanceAdmin() || isAdmin();
    }

    match /payment_ledger/{ledgerId} {
      allow read: if isSignedIn() && (
        resource.data.trainerId == request.auth.uid ||
        isFinanceAdmin() ||
        isAdmin()
      );
      allow create, update, delete: if isFinanceAdmin() || isAdmin();
    }

    match /admin_action_logs/{logId} {
      allow read, create: if isAnyAdminRole();
      allow update, delete: if isAdmin();
    }

    match /platform_settings/{document=**} {
      allow read: if isSignedIn();
      allow write: if isFinanceAdmin() || isAdmin();
    }
  }
}
