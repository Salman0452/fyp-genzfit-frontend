# Simplified Environment Variables for Local Testing
# Copy this to .env for local development

# Cloudinary (Optional - sign up free at cloudinary.com)
# Free tier: 25GB storage, 25GB bandwidth/month
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Leave empty to run in local-only mode (no file uploads)
# Avatar generation will work, but URLs will be local://...
