# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Application
DEBUG=true
APP_NAME=GenzFit Avatar API
VERSION=1.0.0

# Firebase Configuration
# Option 1: Path to service account JSON file
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# Option 2: Service account JSON as string (for deployment)
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"your-project",...}

# Firebase Storage Bucket
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Cloudinary (Optional - Alternative to Firebase Storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://genzfit.web.app

# Model Settings
MAX_MODEL_SIZE_MB=50
THUMBNAIL_WIDTH=512
THUMBNAIL_HEIGHT=512

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
