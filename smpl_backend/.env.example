# Path to SMPL-X model files (download from https://smpl-x.is.tue.mpg.de)
SMPLX_MODEL_PATH=./smpl_models

# Directory for caching generated GLB files
CACHE_DIR=./cache/glb

# Ready Player Me – your app subdomain (e.g. "genzfit" from https://genzfit.readyplayer.me)
# Free tier works without an API key for GLB export.
RPM_APP_ID=demo
RPM_API_KEY=

# Optional: host/port overrides
HOST=0.0.0.0
PORT=8000
