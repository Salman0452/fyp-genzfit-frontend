// Firestore Security Rules for GenZFit
// Deploy these rules to Firebase Console -> Firestore Database -> Rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        getUserRole() == 'admin' ||
        getUserRole() == 'super_admin'
      );
    }

    function isFinanceAdmin() {
      return isSignedIn() && (
        getUserRole() == 'finance_admin' ||
        getUserRole() == 'financeAdmin'
      );
    }

    function isModerator() {
      return isSignedIn() && getUserRole() == 'moderator';
    }

    function isSupport() {
      return isSignedIn() && getUserRole() == 'support';
    }

    function isAnyAdminRole() {
      return isAdmin() || isFinanceAdmin() || isModerator() || isSupport();
    }
    
    function isTrainer() {
      return isSignedIn() && getUserRole() == 'trainer';
    }
    
    function isClient() {
      return isSignedIn() && getUserRole() == 'client';
    }
    
    function isActive() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }
    
    // Users collection
    match /users/{userId} {
      // Restrict reads to self, admin roles, or trainer discovery profiles.
      allow read: if isOwner(userId) ||
        isAnyAdminRole() ||
        (isSignedIn() && resource.data.role == 'trainer');
      
      // Users can create their own document during signup
      // Must be authenticated and creating their own document
      allow create: if isSignedIn() && request.auth.uid == userId;
      
      // Users can update their own document (except role and status)
      // Admins can update any user
      allow update: if (isSignedIn() && isOwner(userId) &&
        request.resource.data.get('role', resource.data.role) == resource.data.role &&
        request.resource.data.get('status', resource.data.status) == resource.data.status) || isAnyAdminRole();
      
      // Only admins can delete users
      allow delete: if isAnyAdminRole();
      
      // Meals subcollection - users can read/write their own meals
      match /meals/{mealId} {
        allow read: if isOwner(userId) || isAnyAdminRole();
        allow create: if isOwner(userId);
        allow update, delete: if isOwner(userId);
      }
      
      // Exercises subcollection - users can read/write their own exercises
      match /exercises/{exerciseId} {
        allow read: if isOwner(userId) || isAnyAdminRole();
        allow create: if isOwner(userId);
        allow update, delete: if isOwner(userId);
      }
    }
    
    // OTP Verification collection
    // Doc ID is the email address
    match /otp_verification/{email} {
      // Users can only read/write OTP for their own email during signup (before auth)
      // So we allow unauthenticated access for initial OTP generation
      allow create: if true; // Allow unauthenticated creation during signup
      allow update, read: if true; // Allow updates and reads during verification
      allow delete: if isAnyAdminRole(); // Only admin roles can delete
    }
    
    // Measurements collection
    match /measurements/{measurementId} {
      allow read: if isOwner(resource.data.userId) || isAnyAdminRole();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId);
    }
    
    // Avatars collection
    match /avatars/{avatarId} {
      allow read: if isOwner(resource.data.userId) || isAnyAdminRole();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId);
    }
    
    // Avatar snapshots collection (SMPL 3D avatar metadata + betas)
    match /avatar_snapshots/{snapshotId} {
      allow read: if isOwner(resource.data.userId) || isAnyAdminRole();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId) || isAnyAdminRole();
      allow delete: if isOwner(resource.data.userId);
    }
    
    // Trainers collection
    match /trainers/{trainerId} {
      // Anyone can read verified trainer profiles
      // Admins can read all (for verification dashboard)
      allow read: if true;
      
      // Trainers can create and update their own profile
      allow create: if isOwner(trainerId) && isTrainer();
      allow update: if isOwner(trainerId) && isTrainer() || isAnyAdminRole();
      
      // Only admins can delete trainer profiles
      allow delete: if isAnyAdminRole();
    }
    // Chats collection
    match /chats/{chatId} {
      // Users can read chats they are part of; admin roles can monitor chats.
      allow read: if isSignedIn() && 
        (
          resource.data.participants.hasAny([request.auth.uid]) ||
          isAnyAdminRole()
        );
      
      // Users can create chats
      allow create: if isSignedIn() && 
        request.resource.data.participants.hasAny([request.auth.uid]);
      
      // Users can update chats they are part of (including sending messages)
      allow update: if isSignedIn() && 
        resource.data.participants.hasAny([request.auth.uid]);
      
      // Messages subcollection
      match /messages/{messageId} {
        // Allow message reads for chat participants and admin roles.
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]) ||
          isAnyAdminRole()
        );
        
        // Allow message creation if user is authenticated and is the sender
        allow create: if isSignedIn() && 
          request.resource.data.senderId == request.auth.uid;
        
        // Allow updates/deletes only by the sender
        allow update, delete: if isSignedIn() && 
          resource.data.senderId == request.auth.uid;
      }
    }
    // Sessions collection
    match /sessions/{sessionId} {
      // Users can read sessions they are part of
      // Admins can read all sessions (for monitoring)
      allow read: if isSignedIn() && 
        (request.auth.uid == resource.data.clientId || 
         request.auth.uid == resource.data.trainerId || 
         isAnyAdminRole());
      
      // Clients can create sessions
      allow create: if isClient() && 
        request.resource.data.clientId == request.auth.uid;
      
      // Trainers, clients, and admins can update sessions
      allow update: if isSignedIn() && 
        (request.auth.uid == resource.data.clientId || 
         request.auth.uid == resource.data.trainerId || 
         isAdmin());
    }
    
    // Recommendations collection
    match /recommendations/{recommendationId} {
      allow read: if isOwner(resource.data.userId) || isAnyAdminRole();
      allow create: if isSignedIn();
      allow update, delete: if isOwner(resource.data.userId);
    }
    
    // Meal completions collection
    match /meal_completions/{completionId} {
      // Allow reads: direct doc read (resource.data exists) or list queries
      // (caller always filters by userId == auth.uid in the query)
      allow read: if isSignedIn() && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        isAnyAdminRole()
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    
    // Exercise completions collection
    match /exercise_completions/{completionId} {
      allow read: if isSignedIn() && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    
    // Weekly schedules collection
    match /weekly_schedules/{scheduleId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId);
    }

    // Weekly plans collection (two-layer AI planning skeleton)
    // Doc ID format: "{userId}_{weekStart}" — ownership is encoded in the doc ID prefix.
    // Using planId.split('_')[0] is not available in rules, so we use resource.data.userId
    // with a null-safe check so that non-existent doc reads (existence checks) don't crash.
    match /weekly_plans/{planId} {
      allow read: if isSignedIn() && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        resource == null && planId.matches(request.auth.uid + '_.*') ||
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    
    // User preferences collection
    match /user_preferences/{userId} {
      allow read: if isOwner(userId) || isAnyAdminRole();
      allow write: if isOwner(userId);
    }

    // Chatbot history collection
    match /chatbot_history/{userId} {
      allow read, write: if isOwner(userId);
      
      match /conversations/{messageId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // Platform analytics (admin only)
    match /platform_analytics/{document=**} {
      allow read: if isAnyAdminRole();
      allow write: if isAnyAdminRole();
    }
    
    // Verification requests
    match /verification_requests/{requestId} {
      // Trainers can read their own requests
      allow read: if isOwner(resource.data.trainerId) || isAnyAdminRole();
      
      // Trainers can create verification requests
      allow create: if isTrainer() && 
        request.resource.data.trainerId == request.auth.uid;
      
      // Only admins can update (approve/reject) requests
      allow update: if isAnyAdminRole();
    }
    
    // Reports collection
    match /reports/{reportId} {
      // Users can read their own reports
      allow read: if isOwner(resource.data.reportedBy) || isModerator() || isSupport() || isAdmin();
      
      // Any signed-in user can create a report
      allow create: if isSignedIn() && 
        request.resource.data.reportedBy == request.auth.uid;
      
      // Moderation/support/admin can update or delete reports
      allow update, delete: if isModerator() || isSupport() || isAdmin();
    }
    
    // Transactions collection (payment records)
    match /transactions/{transactionId} {
      // Clients can read their own transactions
      allow read: if isClient() && resource.data.clientId == request.auth.uid;
      
      // Trainers can read transactions where they are the recipient
      allow read: if isTrainer() && resource.data.trainerId == request.auth.uid;
      
      // Finance/admin can read all transactions
      allow read: if isFinanceAdmin() || isAdmin();
      
      // Clients can create transactions (initiate payment)
      allow create: if isClient() && 
        request.resource.data.clientId == request.auth.uid;
      
      // Clients can update their transactions (add proof image)
      allow update: if isClient() && resource.data.clientId == request.auth.uid &&
        // Can only update clientPaymentProofUrl and paymentMethod before verification
        request.resource.data.status == resource.data.status;
      
      // Only finance/admin can verify/reject payments
      allow update: if (isFinanceAdmin() || isAdmin()) && 
        (request.resource.data.status == 'verified' || 
         request.resource.data.status == 'failed' ||
         request.resource.data.status == 'completed');
    }
    
    // Bank details collection (under trainers subcollection)
    match /trainers/{trainerId}/bank_details/{bankDetailsId} {
      // Trainers can read their own bank details
      allow read: if isOwner(trainerId);
      
      // Finance/admin can read all bank details for verification
      allow read: if isFinanceAdmin() || isAdmin();
      
      // Trainers can create and update their own bank details
      allow create, update: if isOwner(trainerId);
      
      // Only finance/admin can verify bank details
      allow update: if isFinanceAdmin() || isAdmin();
      
      // Trainers can delete their own unverified bank details
      allow delete: if isOwner(trainerId) && 
        resource.data.verificationStatus != 'verified';
    }

    // Collection-group compatibility for bank details verification screens.
    match /{path=**}/bank_details/{bankDetailsId} {
      allow read: if isFinanceAdmin() || isAdmin();
      allow update: if isFinanceAdmin() || isAdmin();
    }
    
    // Payouts collection
    match /payouts/{payoutId} {
      // Trainers can read their own payout requests
      allow read: if isTrainer() && resource.data.trainerId == request.auth.uid;
      
      // Finance/admin can read all payout requests
      allow read: if isFinanceAdmin() || isAdmin();
      
      // Trainers can create payout requests
      allow create: if isTrainer() && 
        request.resource.data.trainerId == request.auth.uid;
      
      // Only finance/admin can approve/process payouts
      allow update: if (isFinanceAdmin() || isAdmin()) && 
        (request.resource.data.status == 'approved' || 
         request.resource.data.status == 'processing' ||
         request.resource.data.status == 'completed' ||
         request.resource.data.status == 'failed');
    }

    // Withdrawal requests for trainer payout operations
    match /withdrawal_requests/{withdrawalId} {
      allow read: if (isTrainer() && resource.data.trainerId == request.auth.uid) ||
        isFinanceAdmin() || isAdmin();
      allow create: if isTrainer() && request.resource.data.trainerId == request.auth.uid;
      allow update: if isFinanceAdmin() || isAdmin();
      allow delete: if isFinanceAdmin() || isAdmin();
    }

    // Earnings ledger used as financial source of truth.
    match /earnings_ledger/{ledgerId} {
      allow read: if (isTrainer() && resource.data.trainerId == request.auth.uid) ||
        isFinanceAdmin() || isAdmin();
      allow create, update, delete: if isFinanceAdmin() || isAdmin();
    }

    // Payment ledger for withdrawal history.
    match /payment_ledger/{ledgerId} {
      allow read: if (isTrainer() && resource.data.trainerId == request.auth.uid) ||
        isFinanceAdmin() || isAdmin();
      allow create, update, delete: if isFinanceAdmin() || isAdmin();
    }

    // Administrative audit logs.
    match /admin_action_logs/{logId} {
      allow read: if isAnyAdminRole();
      allow create: if isAnyAdminRole();
      allow update, delete: if isAdmin();
    }
    
    // Platform settings (for payment configuration)
    match /platform_settings/{document=**} {
      // Anyone can read payment settings
      allow read: if true;
      
      // Only admins can write payment settings
      // Use direct role check to avoid getUserRole() issues
      allow write: if isSignedIn() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'finance_admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'financeAdmin');
    }
  }
}
